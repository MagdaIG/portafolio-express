<div class="hero">
    <div class="container">
        <h1>{{name}}</h1>
        <p>{{description}}</p>
    </div>
</div>

<div class="container">
    <section class="projects-section">
        <h2 style="text-align: center; margin-bottom: 2rem; color: #333; font-size: 2.5rem;">Mis Proyectos Destacados</h2>
        <div class="projects-grid">
            {{#each projects}}
            <div class="project-card">
                <div class="project-image">
                    <i class="fas fa-laptop-code" style="font-size: 3rem; color: #667eea;"></i>
                </div>
                <div class="project-content">
                    <h3 class="project-title">{{title}}</h3>
                    <p class="project-description">{{description}}</p>
                    <div class="technologies">
                        {{#each technologies}}
                        <span class="tech-tag">{{this}}</span>
                        {{/each}}
                    </div>
                    <div class="project-links">
                        <a href="{{github}}" class="project-link" target="_blank" rel="noopener">
                            <i class="fab fa-github"></i> Código
                        </a>
                        <a href="{{demo}}" class="project-link" target="_blank" rel="noopener">
                            <i class="fas fa-external-link-alt"></i> Demo
                        </a>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        <div style="text-align: center; margin-top: 2rem;">
            <a href="/projects" style="color: #667eea; text-decoration: none; font-weight: 500; padding: 0.8rem 2rem; border: 2px solid #667eea; border-radius: 25px; transition: all 0.3s ease;">
                Ver Todos los Proyectos
            </a>
        </div>
    </section>
</div>
